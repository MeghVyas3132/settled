index 0000000..c5818e2
--- /dev/null
+++ b/src/composables/useSettlement.js
@@ -0,0 +1,44 @@
+import { reactive } from 'vue'
+
+/**
+ * Zero-confirmation settlement status for received payments (CHIP-2025-11).
+ *
+ * A payment is only safe to accept before it is mined when the network can raise a
+ * double-spend proof for it: every input of the payment and of its unconfirmed history
+ * must spend a P2PKH output signed SIGHASH_ALL (same rule as BCHN getdsproofscore).
+ * Payments funded by contracts (e.g. a fresh swap, Tap to Pay) or signed SIGHASH_UTXOS
+ * (WizardConnect) can still be reversed, so they are shown as "Pending" until mined.
+ *
+ * Uses the Settled API (https://github.com/MeghVyas3132/settled). Set SETTLED_API to self-host.
+ */
+const API = process.env.SETTLED_API || 'https://settled-api.aexiz.in'
+const states = reactive({})
+
+async function check (txid) {
+  try {
+    const res = await fetch(`${API}/v1/tx/${txid}`)
+    if (!res.ok) throw new Error(res.statusText)
+    const report = await res.json()
+    states[txid] = { state: report.state, reasons: [...new Set(report.reasons.map(r => r.message))] }
+    return states[txid]
+  } catch (error) {
+    states[txid] = { state: 'unknown', reasons: [] }
+    return states[txid]
+  }
+}
+
+/** Polls until the payment is safe, confirmed, or 30 minutes pass. */
+export function trackSettlement (txid) {
+  if (!txid || states[txid]) return
+  states[txid] = { state: 'checking', reasons: [] }
+  const until = Date.now() + 30 * 60 * 1000
+  const tick = async () => {
+    const s = await check(txid)
+    if (s.state === 'pending' && Date.now() < until) setTimeout(tick, 5000)
+  }
+  tick()
+}
+
+export function settlementOf (txid) {
+  return states[txid]
+}
