# Settled API on settled-api.aexiz.in (mainnet, read-only chain checks + broadcast of user-signed txs).
# Load only after DNS resolves (A settled-api -> origin, proxied through Cloudflare).
settled-api.aexiz.in {
	encode gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	request_body {
		max_size 256KB
	}
	# flush_interval -1: stream Server-Sent Events immediately
	reverse_proxy settled-api-1:8787 {
		flush_interval -1
	}
}
